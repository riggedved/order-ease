# Order Ease Environment Configuration Example

# Environment Mode: development | production
# In production mode (ENV=production), JWT_SECRET must be set or the app will refuse to start.
ENV=development

# JWT Secret Token (HS256)
# In development, defaults to a local dev secret key if omitted.
# In production, must be a secure 32+ character random string.
JWT_SECRET=

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g. https://your-app.vercel.app).
# Optional: requests routed via Vercel rewrites are same-origin.
ALLOWED_ORIGINS=

# Database Connection URL
# Defaults to local SQLite file at repo root if omitted.
DATABASE_URL=sqlite:///./orderease.db

# Vernacular Order Capture Parser Mode
# Options: rule (default, requires no API key), llm (LLM-only), or auto (LLM with rule fallback).
CAPTURE_PARSER=rule

# LLM API Key (OpenAI-compatible / Groq endpoint)
# Only needed when CAPTURE_PARSER is set to 'llm' or 'auto'.
LLM_API_KEY=
